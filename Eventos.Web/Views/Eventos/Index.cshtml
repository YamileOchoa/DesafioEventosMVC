@model IEnumerable<EventoListadoItem>
@{
    ViewData["Title"] = "Eventos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Eventos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo evento</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="categoriaId" class="form-select" asp-items="(SelectList)ViewBag.Categorias">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<table class="table table-striped table-hover align-middle bg-white">
    <thead>
        <tr>
            <th>Título</th>
            <th>Categoría</th>
            <th>Fecha</th>
            <th>Lugar</th>
            <th>Modalidad</th>
            <th class="text-end">Precio</th>
            <th class="text-end">Aforo</th>
            <th class="text-end">Inscritos</th>
            <th class="text-end">Cupos</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Titulo</td>
                <td>@item.Categoria</td>
                <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.Lugar</td>
                <td>@item.Modalidad</td>
                <td class="text-end">@item.Precio.ToString("N2")</td>
                <td class="text-end">@item.Aforo</td>
                <td class="text-end">@item.Inscritos</td>
                <td class="text-end">
                    @if (item.CuposDisponibles == 0)
                    {
                        <span class="badge bg-danger">Agotado</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@item.CuposDisponibles</span>
                    }
                </td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalle</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="10" class="text-center text-muted py-4">No hay eventos para mostrar.</td>
            </tr>
        }
    </tbody>
</table>
