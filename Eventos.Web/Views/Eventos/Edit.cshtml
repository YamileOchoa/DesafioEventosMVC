@model Evento
@{
    ViewData["Title"] = "Editar evento";
}

<h1 class="h3">Editar evento</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="bg-white border rounded p-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <partial name="_Formulario" model="Model" />

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
